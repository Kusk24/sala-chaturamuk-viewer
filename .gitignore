# Capture data and generated frames — large, regenerable, never committed.
# The directories themselves are kept (.gitkeep) so a fresh clone has the tree.
data/raw/*
data/frames/*
data/selected/*
output/sequence/*
!data/raw/.gitkeep
!data/frames/.gitkeep
!data/selected/.gitkeep
!output/sequence/.gitkeep

# Regenerated on every run, and pointing at frames that are ignored above.
viewer/manifest.json
viewer/manifest.js
output/debug/

# output/metrics/ is deliberately NOT ignored — measured CSVs are the only
# source for numbers in the paper, so they are versioned. output/matches.json
# and output/pipeline_run.json are kept for the same reason: they record what
# was measured and with which parameters.

*.mov
*.mp4
*.MOV
.venv/
__pycache__/
*.pyc
.DS_Store
