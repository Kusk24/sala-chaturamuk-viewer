# Capture data and generated frames — large, regenerable, never committed.
# The directories themselves are kept (.gitkeep) so a fresh clone has the tree.
# The _* patterns cover --version-name runs (data/selected_myversion/, etc.)
# and data/raw_versions/*/ covers every archived capture under its own name.
data/raw/*
data/raw_versions/*/*
data/frames/*
data/frames_*/*
data/selected/*
data/selected_*/*
output/sequence/*
output/sequence_*/*
!data/raw/.gitkeep
!data/raw_versions/.gitkeep
!data/frames/.gitkeep
!data/selected/.gitkeep
!output/sequence/.gitkeep

# Regenerated on every run, and pointing at frames that are ignored above.
viewer/manifest.json
viewer/manifest.js
viewer/manifest_*.json
viewer/manifest_*.js
output/debug/

# output/metrics*/ is deliberately NOT ignored — measured CSVs are the only
# source for numbers in the paper, so they are versioned. output/matches*.json,
# output/pipeline_run*.json, and viewer/versions.json(.js) are kept for the
# same reason: they record what was measured, with which parameters, and
# which named versions exist -- small facts, not the large data behind them.

*.mov
*.mp4
*.MOV
.venv/
__pycache__/
*.pyc
.DS_Store

# COLMAP reconstruction working data -- databases, sparse/dense models and
# point clouds are large and fully regenerable from the photographs by
# recon/run_sfm.sh. The scripts and any measured summary stay tracked.
recon/*/database.db*
recon/*/sparse/
!recon/*/camera_path.json
!recon/*/camera_path.png
recon/*/dense/
recon/*/*.ply

# Word lock/autosave files
~$*
recon/*.zip

# Compiled Swift tool and reconstructed meshes -- regenerable from source
# and photographs by recon/objectcapture/main.swift.
recon/objectcapture/photogrammetry
recon/*/*.usdz
recon/*/*.obj
data/selected_combined/

# COLMAP undistortion output -- rectified copies of the photographs plus a
# rewritten PINHOLE model, regenerable by run_sfm.sh in under a minute.
recon/*/undistorted/
data/selected_combined_loop/

# Kaggle kernel output pulled by `kaggle kernels output` -- the trained
# gaussian model, its intermediate iterations and the held-out renders.
# Hundreds of megabytes, and regenerable by re-running the notebook.
recon/kaggle_output/

# Masked-photogrammetry regenerables: per-image sky masks (make_masks.py),
# compiled tools, and the usdz meshes (already covered by recon/*/*.usdz).
recon/objectcapture/masks_*/
recon/objectcapture/photogrammetry_masked
recon/objectcapture/usdz_snap
